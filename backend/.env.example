# Database Configuration
# Production MUST use PostgreSQL. SQLite is for local development only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Security & CORS
# Must exactly match the deployed frontend URL (e.g., https://nimshop.vercel.app)
FRONTEND_URL=http://localhost:5173

# Nimiq Configuration
NIMIQ_NETWORK=testnet
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com/

# AI Configuration (Optional, defaults to mock)
AI_PROVIDER=mock # Deterministic intent extraction on real catalog. Safe for demo. # Deterministic intent extraction on real catalog. Safe for demo.
